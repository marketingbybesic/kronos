        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara aplikaciju Prečaci i traži potvrdu. Ako Kronosa nema u izborniku Dijeli, uključi Prikaži u izborniku Dijeli u detaljima prečaca."
