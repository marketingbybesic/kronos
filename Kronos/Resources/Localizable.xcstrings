    "app.schema.toonew": {
      "comment": "Readable launch window: the data was written by a newer Kronos. %1$lld = schema of this build, %2$lld = schema the data needs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These data were saved by a newer Kronos (version %2$lld; this one handles %1$lld). Nothing was changed. Update Kronos to open them."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove podatke je spremio noviji Kronos (verzija %2$lld; ovaj razumije %1$lld). Ništa nije promijenjeno. Ažuriraj Kronos da ih otvoriš."
          }
        }
      }
    },
