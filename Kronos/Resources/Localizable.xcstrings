    "settings.notifications.pre.body": {
      "comment": "Block start notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for permission next. Kronos only sends the start notification for a block with a linked task, with Done, Not now and Open on it."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS će zatim tražiti dopuštenje. Kronos šalje samo obavijest o početku bloka s povezanim zadatkom, s gumbima Gotovo, Ne sada i Otvori."
          }
