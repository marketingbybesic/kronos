    "app.save_failed.body": {
      "comment": "Backups and import safety.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are still on screen and a copy was written to the backups folder. Free some disk space, then keep working or restart Kronos."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još su na ekranu, a kopija je zapisana u mapu sigurnosnih kopija. Oslobodi malo prostora na disku, pa nastavi raditi ili ponovno pokreni Kronos."
          }
        }
      }
    },
    "app.save_failed.folder": {
