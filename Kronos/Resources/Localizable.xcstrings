      }
    },
    "app.launch.error.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was changed or deleted. A copy of your data was saved first, then Kronos stopped here so nothing can be overwritten. Send the message below to support or restore from the backups folder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije promijenjeno ni obrisano. Prvo je spremljena kopija tvojih podataka, a Kronos se zaustavio da se ništa ne može prepisati. Pošalji poruku ispod podršci ili vrati podatke iz mape sa sigurnosnim kopijama."
          }
        }
      }
    },
    "app.launch.error.open": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
