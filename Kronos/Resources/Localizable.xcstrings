    "agents.delivery.help.webhook": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each event is sent signed with a secret only you and the receiver know. Failed sends are retried for 24 hours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki se događaj šalje potpisan tajnim ključem koji znaju samo ti i primatelj. Neuspjeli pokušaji ponavljaju se 24 sata."
          }
        }
      }
    },
    "agents.delivery.help.ntfy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a topic of its own, not the one that alerts your phone. Nothing is sent unless you set this."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebi vlastitu temu, a ne onu koja šalje obavijesti na tvoj telefon. Ništa se ne šalje dok ovo ne postaviš."
          }
        }
      }
    },
    "agents.delivery.help.command": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a command on this Mac whenever something happens — handy if you already have a script or automation. Kronos sends the event details as JSON on standard input (no shell is used: words are split at spaces)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće naredbu na ovom Macu kad god se nešto dogodi — korisno ako već imaš skriptu ili automatizaciju. Kronos šalje podatke o događaju kao JSON na standardnom ulazu (ljuska se ne koristi: riječi se dijele po razmacima)."
          }
        }
      }
    },
