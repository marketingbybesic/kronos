      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copy could be made. The original files are untouched."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiju nije bilo moguće napraviti. Izvorne datoteke su netaknute."
          }
