    "welcome.intro.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task app built for an ADHD brain: less deciding, less looking, less effort to start."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija za zadatke napravljena za ADHD mozak: manje odlučivanja, manje traženja, lakši početak."
          }
        }
      }
    },
    "welcome.intro.idea1.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the quick add shortcut anywhere on your Mac and just type. Kronos reads the date, project and priority from your words."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipkom za brzi unos bilo gdje na Macu samo upiši. Kronos iz tvojih riječi pročita datum, projekt i prioritet."
          }
        }
      }
    },
    "welcome.intro.idea1.keys": {
      "comment": "Label next to the quick add keycaps on the intro",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from any app"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iz bilo koje aplikacije"
          }
        }
      }
    },
    "welcome.intro.idea1.title": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throw everything in"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubaci sve"
          }
        }
      }
    },
    "welcome.intro.idea2.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card on top of your list and the circle in the menu bar show one task and its first move. The rest stays out of sight."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica na vrhu popisa i kružić u traci izbornika pokazuju jedan zadatak i njegov prvi potez. Sve ostalo ostaje sklonjeno."
          }
        }
      }
    },
    "welcome.intro.idea2.title": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See only what is next"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidi samo ono što je sljedeće"
          }
        }
      }
    },
    "welcome.intro.idea3.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split big things into tiny subtasks. The next open subtask becomes your first move, and every finish plays a sound."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razbij velike stvari na male podzadatke. Sljedeći otvoreni podzadatak postaje tvoj prvi potez, a svaki završetak ima svoj zvuk."
          }
        }
      }
    },
    "welcome.intro.idea3.title": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start small, finish often"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreni malo, završavaj često"
          }
        }
      }
    },
    "welcome.intro.idea4.body": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Learn Kronos card at the top of your list lets you try every feature, one at a time. It suggests what to try next and ticks itself when you do it."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica Upoznaj Kronos na vrhu popisa daje ti da isprobaš svaku funkciju, jednu po jednu. Predloži što sljedeće probati i sama se označi kad to napraviš."
          }
        }
      }
    },
    "welcome.intro.idea4.title": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn it when you have time"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uči kad imaš vremena"
          }
        }
      }
    },
