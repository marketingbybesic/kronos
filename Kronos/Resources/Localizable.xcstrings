    "settings.coach.houserules.help": {
      "comment": "House rules and AI egress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short rules that Sort, Pick one and Up next follow when they ask the model. A rule an agent proposes waits here, switched off, until you turn it on."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratka pravila koja Razvrstaj, Odaberi jedan i Sljedeće slijede kad pitaju model. Pravilo koje predloži agent čeka ovdje, isključeno, dok ga ne uključiš."
