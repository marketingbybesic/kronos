    "agents.fullcontrol.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full control"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puna kontrola"
          }
        }
      }
    },
    "agents.fullcontrol.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May change, complete and reopen any task, edit subtasks, and manage projects, areas and labels. It never deletes your tasks and never decides your review."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smije mijenjati, dovršavati i ponovno otvarati bilo koji zadatak, uređivati podzadatke i upravljati projektima, područjima i oznakama. Nikad ne briše tvoje zadatke i nikad ne odlučuje o tvom pregledu."
          }
        }
      }
    },
    "agents.fullcontrol.shared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs its own token. Press Connect all local AI tools in Settings > MCP, then this switch works."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treba vlastiti token. Pritisni Poveži sve lokalne AI alate u Postavke > MCP, pa ovaj prekidač radi."
          }
        }
      }
    },
    "agents.fullcontrol.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %@ full control? It can then change or complete any of your tasks. You can undo its work for today from here and turn this off at any time."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati agentu %@ punu kontrolu? Tada može mijenjati ili dovršavati sve tvoje zadatke. Njegov današnji rad možeš poništiti ovdje, a ovo možeš isključiti u bilo kojem trenutku."
          }
        }
      }
    },
