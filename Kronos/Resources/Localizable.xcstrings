    "welcome.primer.body": {
      "comment": "Pre-permission screen body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each permission switches on one extra feature, such as your calendar blocks or your reminders. You go through them one by one, and macOS asks before anything is allowed."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka dozvola uključuje jednu dodatnu mogućnost, na primjer tvoje vremenske blokove ili podsjetnike. Prolaziš ih jednu po jednu, a macOS pita prije nego išta dopusti."
          }
        }
      }
    },
    "welcome.primer.continue": {
      "comment": "Pre-permission button: never Allow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi"
          }
        }
      }
    },
    "welcome.primer.later": {
      "comment": "Pre-permission screen, leave it for later",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne sada"
          }
        }
      }
    },
    "welcome.primer.title": {
      "comment": "Pre-permission screen title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kronos works without any permission"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kronos radi i bez ikakvih dozvola"
          }
        }
      }
    },
    "welcome.quest.attach.how": {
      "comment": "Spec 3.1 App-level, sidebar, views.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a file from Finder or an email from Mail onto the task. One click opens it later."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
