    "settings.ai.egress": {
      "comment": "House rules and AI egress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With AI on, Kronos sends the title of a task and the first 300 characters of its notes, up to 8 titles of similar tasks, your project and label names and your active house rules to the model you chose. Pasted notes for Capture go up to 6,000 characters, with at most 50 open task titles. Email addresses, phone numbers, long numbers and links with a query are removed first. With AI off, nothing is sent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je AI uključen, Kronos modelu koji si odabrao šalje naslov zadatka i prvih 300 znakova bilješki, do 8 naslova sličnih zadataka, nazive tvojih projekata i oznaka te aktivna kućna pravila. Zalijepljene bilješke za Hvatanje idu do 6000 znakova, uz najviše 50 naslova otvorenih zadataka. Adrese e-pošte, telefonski brojevi, dugi brojevi i poveznice s upitom prethodno se uklanjaju. Kad je AI isključen, ništa se ne šalje."
          }
        }
      }
    },
    "settings.coach.section.houserules": {
