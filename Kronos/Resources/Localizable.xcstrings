    "settings.notifications.blockstart.help": {
      "comment": "Block start notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a calendar block with a linked task begins, one notification shows your first move. Nothing else, and never for due dates."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad počne blok iz kalendara s povezanim zadatkom, stiže jedna obavijest s prvim potezom. Ništa drugo, i nikad za rokove."
          }
        }
      }
