    "settings.shortcuts.share.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a link or selected text from Safari, Mail or any app straight to Kronos with the Share menu."
          }
